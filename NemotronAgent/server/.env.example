# Copy to .env and fill in. Same keys that were hardcoded in Providers.kt.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where memory.txt / conversations.json / task_history.json are stored.
DATA_DIR=./data

# host/port the server binds to. With `adb reverse tcp:8000 tcp:8000`,
# the phone reaches this as http://127.0.0.1:8000 too.
HOST=0.0.0.0
PORT=8000
